                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Durum kodu 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Doğru görev döndü\", () => {",
                  "  pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get(\"taskId\")));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Görev Güncelle (PATCH - kısmi)",
