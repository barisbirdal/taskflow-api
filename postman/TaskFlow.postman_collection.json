{
  "info": {
    "name": "TaskFlow API",
    "description": "TaskFlow - Görev ve Proje Yönetim Sistemi REST API test koleksiyonu.\n\nKullanım: Sunucuyu `npm start` ile başlatın, koleksiyonu içe aktarın ve \"Run collection\" ile tüm istekleri sırasıyla çalıştırın. \"1 - Görev CRUD\" klasörü sırayla çalıştırılmalıdır (oluşturulan görevin id'si `taskId` değişkenine kaydedilir).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "taskId",
      "value": "1"
    },
    {
      "key": "projectId",
      "value": "3"
    }
  ],
  "item": [
    {
      "name": "1 - Görev CRUD (Zorunlu)",
      "item": [
        {
          "name": "1. Görev Ekle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"API dokümantasyonunu yaz\",\n  \"description\": \"Tüm endpointler için request/response örnekleri\",\n  \"priority\": \"high\",\n  \"assignee\": \"Musa\",\n  \"projectId\": 1,\n  \"dueDate\": \"2026-10-30\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Durum kodu 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Görev oluşturuldu\", () => {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data).to.have.property(\"id\");",
                  "  pm.expect(json.data.title).to.eql(\"API dokümantasyonunu yaz\");",
                  "  pm.expect(json.data.status).to.eql(\"todo\");",
                  "});",
                  "pm.collectionVariables.set(\"taskId\", json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Görevleri Listele",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Durum kodu 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Liste dizi olarak döner\", () => pm.expect(json.data).to.be.an(\"array\"));",
                  "pm.test(\"Yeni görev listede var\", () => {",
                  "  const id = Number(pm.collectionVariables.get(\"taskId\"));",
                  "  pm.expect(json.data.map(t => t.id)).to.include(id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Görev Detayı",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": [
