              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Durum kodu 200\", () => pm.response.to.have.status(200));",
                  "const task = pm.response.json().data;",
                  "pm.test(\"Alanlar güncellendi\", () => {",
                  "  pm.expect(task.status).to.eql(\"in-progress\");",
                  "  pm.expect(task.priority).to.eql(\"medium\");",
                  "  pm.expect(task.title).to.eql(\"API dokümantasyonunu yaz\");",
                  "});"
